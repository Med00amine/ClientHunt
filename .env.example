# Copy to .env and edit. Never commit .env.

# --- Required before exposing the app beyond your own machine ---
APP_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set true when served over HTTPS
COOKIE_SECURE=false

# --- Database (default: SQLite file in data/). Docker Compose overrides this with PostgreSQL. ---
# DATABASE_URL=postgresql+psycopg://clienthunt:CHANGE_ME@db:5432/clienthunt
POSTGRES_PASSWORD=

# --- Budget (USD) ---
MONTHLY_BUDGET_USD=10
DEFAULT_RUN_BUDGET_USD=1
MAX_COMPANIES_PER_RUN=10
MAX_DRAFTS_PER_RUN=3
MAX_RESULTS_PER_SOURCE=200

# --- Optional LLM drafting (off by default; template drafts cost $0) ---
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# UNVERIFIED defaults: set to the current published prices for your model
LLM_PRICE_IN_PER_MTOK=1.0
LLM_PRICE_OUT_PER_MTOK=5.0

# --- Optional authorised keys ---
HIMALAYAS_API_KEY=
FREELANCER_OAUTH_TOKEN=
UPWORK_API_KEY=

HTTP_USER_AGENT=ClientHuntBot/0.1 (personal job-search tool; contact: you@example.com)
